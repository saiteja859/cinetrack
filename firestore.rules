rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());

      function isValidUserProfile(data) {
        return data.keys().hasAll(['uid']) &&
               data.uid == request.auth.uid &&
               (data.get('displayName', '') is string) &&
               (data.get('photoURL', '') is string);
      }

      // Tracked Items Rules
      match /trackedItems/{itemId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTrackedItem(incoming());
        allow update: if isOwner(userId) && isValidTrackedItem(incoming());
        allow delete: if isOwner(userId);

        function isValidTrackedItem(data) {
          return data.keys().hasAll(['id', 'title', 'userId', 'status']) &&
                 data.userId == request.auth.uid &&
                 data.status in ['planned', 'watching', 'completed', 'overdue'] &&
                 data.id is string &&
                 data.title is string &&
                 data.title.size() <= 200;
        }
      }
    }
  }
}
